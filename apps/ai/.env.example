# Biến bắt buộc (fail-fast khi thiếu):
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# Biến tuỳ chọn (giá trị mặc định):
OLLAMA_TIMEOUT_S=180
MAX_UPLOAD_MB=10
MAX_PAGES=20
MAX_LLM_CHARS=24000
OCR_ENABLED=false
OCR_LANGS=vie+eng
STRICT_EVIDENCE=true
ALLOW_LEGACY_DOC=false
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
LOG_LEVEL=INFO

# Retrieval/recommendation (tuỳ chọn):
# CHROMA_PATH=/data/chroma  (bỏ trống -> ephemeral, mất khi restart)
CHROMA_PATH=
RECOMMEND_POOL_SIZE=100
RECOMMEND_TOP_K=10

# Hàng đợi xử lý file nền (docs/DESIGN_processing_queue.md):
PROCESSING_DB_PATH=data/processing.db
PROCESSING_FILES_DIR=data/processing_files
PROCESSING_WORKER_ENABLED=1
JOB_MAX_ATTEMPTS=3
JOB_STALE_SECONDS=300
JOB_POLL_INTERVAL_S=1.0
JOB_RETRY_BASE_DELAY_S=1.0

# Bảo mật nội bộ (H26): shared secret cho /internal/* qua header X-Internal-Token.
# Bỏ trống -> endpoint nội bộ MỞ (chỉ dùng cho dev). Production PHẢI đặt giá trị mạnh.
INTERNAL_API_KEY=